			"function methods:AddRotationZ(v) return self:addrotationz(v) end",
			"function methods:diffusealpha(v) return tween(self, {alpha = v}) end",
			"function methods:SetDiffuseAlpha(v) return self:diffusealpha(v) end",
			"function methods:text(v) setImmediate(self, 'text', v); return self end",
			"function methods:SetText(v) return self:text(v) end",
			"function methods:visible(v) setImmediate(self, 'visible', v); return self end",
			"function methods:SetVisible(v) return self:visible(v) end",
			"function methods:hidden(v) setImmediate(self, 'hidden', v == nil or v == true or v == 1); return self end",
			"function methods:SetHidden(v) return self:hidden(v) end",
			"function methods:diffuse(r, g, b, a) _actorFrameSetColor(self.Tag, r, g, b, a); return self end",
			"function methods:SetDiffuse(r, g, b, a) return self:diffuse(r, g, b, a) end",
			"function methods:blend(v) setImmediate(self, 'blend', v); return self end",
			"function methods:additiveblend(v) if v == nil or v then setImmediate(self, 'blend', 'add') else setImmediate(self, 'blend', 'normal') end; return self end",
			"function methods:aux(v) return tween(self, {aux = v}) end",
			"function methods:getaux() return getImmediate(self, 'aux') or 0 end",
			"function methods:GetName() return self.Name end",
			"function methods:GetParent() return self.Parent end",
			"function methods:GetChildren() return self.Children end",
			"function methods:GetChild(name)",
			"  name = tostring(name or '')",
			"  for _, child in ipairs(self.Children or {}) do",
			"    if tostring(child.Name or '') == name or tostring(child.Tag or '') == name or tostring(child.Tag or ''):match('%.' .. name .. '$') then return child end",
