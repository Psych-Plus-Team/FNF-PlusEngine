			"function methods:zoomtowidth(w) setImmediate(self, 'width', w); return self end",
			"function methods:zoomtoheight(h) setImmediate(self, 'height', h); return self end",
			"function methods:stretchto(l, t, r, b) self:x(((tonumber(l) or 0) + (tonumber(r) or 0)) * 0.5); self:y(((tonumber(t) or 0) + (tonumber(b) or 0)) * 0.5); return self:zoomto((tonumber(r) or 0) - (tonumber(l) or 0), (tonumber(b) or 0) - (tonumber(t) or 0)) end",
			"function methods:rotationx(v) return tween(self, {rotationx = v}) end",
			"function methods:SetRotationX(v) return self:rotationx(v) end",
			"function methods:rotationy(v) return tween(self, {rotationy = v}) end",
			"function methods:SetRotationY(v) return self:rotationy(v) end",
